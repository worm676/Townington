# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model every agent uses (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase — Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n / GoHighLevel webhooks. call_webhook("CRM", ...) posts to N8N_WEBHOOK_CRM, etc.
# Add more with the N8N_WEBHOOK_<NAME> pattern and list the name in src/lib/agents.ts.
N8N_WEBHOOK_CRM=
N8N_WEBHOOK_EMAIL=

# Optional: protect the whole app with HTTP Basic Auth (strongly recommended on a public URL)
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
