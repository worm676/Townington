# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model every agent uses (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase — URL from the Connect button, secret key from Project Settings → API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Not used by the app (the browser never talks to Supabase directly); safe to leave blank.
SUPABASE_ANON_KEY=

# n8n / GoHighLevel webhooks. call_webhook("CRM", ...) posts to N8N_WEBHOOK_CRM, etc.
# Add more with the N8N_WEBHOOK_<NAME> pattern and list the name in src/lib/agents.ts.
N8N_WEBHOOK_CRM=
N8N_WEBHOOK_EMAIL=

# Login for the whole app. Required on Vercel production (the site stays locked without them).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
